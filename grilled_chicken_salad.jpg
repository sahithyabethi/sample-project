{% extends 'base.html' %}

{% block content %}
<div class="container">
    <div class="form-card glass">
        <h2 style="margin-bottom: 2rem; text-align: center;">Create Account</h2>
        <form method="post">
            {% csrf_token %}
            {% for field in form %}
            <div class="form-group">
                <label>{{ field.label }}</label>
                <input type="{{ field.field.widget.input_type }}" name="{{ field.name }}" class="form-control"
                    placeholder="{{ field.label }}">
                {% if field.help_text %}
                <small style="color: #888;">{{ field.help_text }}</small>
                {% endif %}
            </div>
            {% endfor %}
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Sign Up</button>
        </form>
        <p style="margin-top: 1.5rem; text-align: center; color: #ccc;">
            Already have an account? <a href="{% url 'login' %}" style="color: var(--secondary-color);">Login</a>
        </p>
    </div>
</div>
{% endblock %}